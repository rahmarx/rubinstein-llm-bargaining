# Copy this file to .env and fill in your own values, or export these
# directly in your shell. Never commit the real values.
#
# Shared course API key (from Canvas) — same for every student.
TAMU_API_KEY=sk-...
#
# Your personal Cloudflare Access cookie (from chat.tamu.ai DevTools),
# including the "CF_Authorization=" prefix. Expires roughly every 24 hours.
CF_COOKIE=CF_Authorization=eyJ...
